[Unit]
Description=Check Family Hub photo integrity
Requires=family-hub-database.service
After=family-hub-database.service
RequiresMountsFor=/mnt/family-hub-data

[Service]
Type=oneshot
User=family-hub
Group=family-hub
WorkingDirectory=/opt/family-hub/current/backend
EnvironmentFile=/etc/family-hub/backend.env
ExecStartPre=/opt/family-hub/current/backend/.venv/bin/python -m app.commands.report_monitoring --job integrity --event start
ExecStart=/opt/family-hub/current/backend/.venv/bin/python -m app.commands.check_photo_integrity
ExecStopPost=/opt/family-hub/current/backend/.venv/bin/python -m app.commands.report_monitoring --job integrity --result=${SERVICE_RESULT}
TimeoutStartSec=2h
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
