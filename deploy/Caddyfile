{
	servers {
		trusted_proxies static 127.0.0.1/8 ::1
		client_ip_headers CF-Connecting-IP
	}
}

:8080 {
	bind 127.0.0.1
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' blob: data:; style-src 'self'; script-src 'self'; worker-src 'self'; manifest-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
	}

	handle /api/v1/readiness {
		respond 404
	}

	handle /api/* {
		header Cache-Control "private, no-store"
		reverse_proxy 127.0.0.1:8000
	}

	handle /assets/* {
		root * /opt/family-hub/current/frontend/dist
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /sw.js {
		root * /opt/family-hub/current/frontend/dist
		header Cache-Control "no-store"
		header Cloudflare-CDN-Cache-Control "no-store"
		file_server
	}

	handle {
		root * /opt/family-hub/current/frontend/dist
		header Cache-Control "no-cache, must-revalidate"
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/family-hub/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format filter {
			request>headers delete
			wrap json
		}
	}
}
