# Copy this file to .env and adjust the values for your environment.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=18000
APP_RELOAD=true
# Application log level. Logs are written to stderr and collected by systemd in production.
APP_LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:15173
DATABASE_URL=postgresql+psycopg://fastapi:replace-with-a-local-password@127.0.0.1:15432/fastapi_playground

# Authentication. In production, use only the HTTPS origin published through Cloudflare Tunnel and Caddy.
AUTH_TRUSTED_ORIGINS=http://localhost:15173
AUTH_SESSION_IDLE_SECONDS=604800
AUTH_SESSION_ABSOLUTE_SECONDS=2592000
AUTH_SESSION_TOUCH_SECONDS=3600
AUTH_COOKIE_SECURE=false
AUTH_LOGIN_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300

# Photo storage safety settings. PHOTO_STORAGE_ROOT must be the internal-HDD mount point itself.
PHOTO_STORAGE_ROOT=/mnt/family-hub-data
PHOTO_STORAGE_MARKER=replace-with-a-random-storage-marker
# Optional. Defaults to backend/var/photo-derivatives on the internal SSD.
# PHOTO_DERIVATIVE_ROOT=/absolute/path/to/photo-derivatives
PHOTO_MAX_UPLOAD_BYTES=104857600
PHOTO_MIN_FREE_BYTES=10737418240
PHOTO_UPLOAD_CHUNK_BYTES=1048576
PHOTO_DEFAULT_TIMEZONE=Asia/Tokyo
PHOTO_TRASH_RETENTION_DAYS=30

# Optional disconnected external HDD used for versioned local snapshots. The marker file is
# .family-hub-backup-marker. Mount it only while a backup is running.
BACKUP_STORAGE_ROOT=/mnt/family-hub-backup
BACKUP_STORAGE_MARKER=

# Optional Web Push. Keep the private key file outside the repository.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY_FILE=
PUSH_VAPID_SUBJECT=mailto:admin@example.com
PUSH_ALLOWED_ENDPOINT_HOSTS=web.push.apple.com,fcm.googleapis.com,updates.push.services.mozilla.com
PUSH_MAX_SUBSCRIPTIONS_PER_USER=10

# Optional Healthchecks-compatible ping URLs used by systemd maintenance units.
# Keep actual check identifiers in /etc/family-hub/backend.env, never in the repository.
MONITORING_PING_URL_DB_BACKUP=
MONITORING_PING_URL_INTEGRITY=
MONITORING_PING_URL_TRASH_PURGE=
MONITORING_PING_URL_NOTIFICATIONS=
MONITORING_PING_URL_CHORE_NOTIFICATIONS=
MONITORING_PING_URL_SECONDARY_BACKUP=

# PostgreSQL container initialization settings.
POSTGRES_DB=family-hub-db
POSTGRES_USER=family-hub-user
POSTGRES_PASSWORD=replace-with-a-local-password
